<?xml version="1.0" encoding="utf-8" ?>
<!--
  AHIP restyle of the GPS widget: a card with a short instruction and a large green
  "Record GPS location" button; latitude / longitude appear below it once captured.
  Keeps the library layout's view ids and types.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/item_margin_horizontal"
    android:layout_marginTop="@dimen/item_margin_vertical"
    android:background="@drawable/ahip_field_card"
    android:orientation="vertical"
    android:padding="14dp">

    <com.google.android.fhir.datacapture.views.GroupHeaderView
        android:id="@+id/header"
        style="?attr/questionnaireGroupTypeHeaderStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.google.android.fhir.datacapture.views.MediaView
        android:id="@+id/item_media"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/ahip_gps_hint"
        android:textColor="#5B6275"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/gps_widget_button"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:text="@string/record_gps_location"
        android:textAllCaps="false"
        android:textSize="16sp"
        app:backgroundTint="@color/ahip_green"
        app:cornerRadius="28dp"
        app:icon="@drawable/gm_location_on_24"
        app:iconGravity="textStart"
        app:iconTint="@android:color/white" />
</LinearLayout>
